{
  "name": "ffrwd/rfdetr",
  "version": "0.4.1",
  "description": "RF-DETR detection, instance segmentation, face detection and licence plate detection: rows, mattes and the utilities that turn rows into mattes or drawn overlays. The weights are Roboflow's, a third-party face fine-tune and our own plate fine-tune, all Apache-2.0, fetched at install.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/imbcmdth/ffrwd-package-rfdetr",
  "capabilities": [
    "nn"
  ],
  "dependencies": {
    "ffrwd/wasm": "0.19.1",
    "ffrwd/mask_tools": "1.1.1"
  },
  "keywords": [
    "rfdetr",
    "detr",
    "detection",
    "segmentation",
    "mask",
    "matte",
    "blur",
    "mosaic",
    "privacy",
    "face",
    "faces",
    "nn",
    "plate",
    "plates",
    "redaction"
  ],
  "lib": {
    "detect": "src/model.sql",
    "detect_faces": "src/model.sql",
    "detect_plates": "src/model.sql",
    "segment_mask": "src/model.sql",
    "boxes_mask": "src/boxes.sql",
    "draw_boxes": "src/boxes.sql"
  },
  "bin": {
    "blur-people": "recipes/blur-people.sql",
    "mosaic-people": "recipes/mosaic-people.sql",
    "spotlight": "recipes/spotlight.sql",
    "replace-background": "recipes/replace-background.sql",
    "draw": "recipes/draw.sql",
    "detections": "recipes/detections.sql",
    "blur-faces": "recipes/blur-faces.sql",
    "mosaic-faces": "recipes/mosaic-faces.sql",
    "draw-faces": "recipes/draw-faces.sql",
    "faces": "recipes/faces.sql",
    "blur-plates": "recipes/blur-plates.sql",
    "mosaic-plates": "recipes/mosaic-plates.sql",
    "draw-plates": "recipes/draw-plates.sql",
    "plates": "recipes/plates.sql",
    "redact": "recipes/redact.sql"
  },
  "models": {
