      "revision": "9690caf9f62195acb985155b2b67224e623e1443",
      "file": "rf-detr-seg-large.onnx",
      "sha256": "e6154493b7ba38c285f416db812589267a7292a736fa8564577bcd27a9012e9e"
    }
  }
}
